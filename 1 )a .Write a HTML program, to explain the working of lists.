<!DOCTYPE html>
<head>
<title>HTML Lists</title>
</head>
<body>
<h1>HTML Lists</h1>
<h2>Ordered List</h2>
<ol>
<li>Item One</li>
<li>Item Two</li>
<li>Item Three</li>
</ol>
<h2>Unordered List</h2>
<ul>
<li>Apple</li>
<li>Banana</li>
<li>Cherry</li>
</ul>
<h2>Nested List</h2>
<ul>
<li>Fruits<ul>
<li>Apple</li>
<li>Banana</li>
</ul>
</li>
<li>Vegetables<ul>
<li>Carrot</li>
<li>Spinach</li>
</ul>
</li>

</ul>
<h2>Ordered List in Unordered List</h2>
<ul>
<li>Steps to Prepare Tea
<ol>
<li>Boil Water</li>
<li>Add Tea Leaves</li>
<li>Pour into Cup</li>
</ol>
</li>
</ul>
<h2>Definition List</h2>
<dl>
<dt>HTML</dt>
<dd>HyperText Markup Language</dd>
<dt>CSS</dt>
<dd>Cascading Style Sheets</dd>
<dt>JS</dt>
<dd>JavaScript</dd>
</dl>
</body>
</html>
